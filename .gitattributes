# Normalize every text file to LF in the repo and in the working tree,
# regardless of a contributor's core.autocrlf setting. Prettier is configured
# with `endOfLine: "lf"` (.prettierrc), so without this a Windows checkout
# (autocrlf=true) leaves every file permanently "modified" after `pnpm format`.
* text=auto eol=lf

# Files that must stay LF even if git's text detection is unsure.
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.sql  text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never touched by git's EOL conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.mp4  binary
*.webm binary
