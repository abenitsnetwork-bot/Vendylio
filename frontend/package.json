{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev --port 3000 --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:make-superadmin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/make-superadmin.ts",
    "seed:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "smoke:auth": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-auth.ts",
    "provider:sandbox-check": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provider-sandbox-check.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.72.0",
    "@upstash/redis": "^1.34.3",
    "@vercel/otel": "^2.1.2",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.34.0",
    "next": "~16.3.3",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "uber-direct": "^0.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^20.17.10",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "~16.3.3",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.1"
  }
}
