generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Landing page content — SUPERADMIN-editable, platform-wide (not per-store).
// `key` is a fixed manifest defined in lib/siteImageKeys.ts, not a free-form
// CMS field list; a row simply doesn't exist yet for a key nobody has
// uploaded an image for, and the public read falls back to a UI placeholder.
// ───────────────────────────────────────────────────────────────────────
model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  altText   String?
  updatedAt DateTime @updatedAt
}

// Platform testimonials ("what our sellers say" on the homepage) — distinct
// from the per-order `Review` model (Phase 8): a Review is a buyer's rating
// of a specific product/order inside one store, a Testimonial is a seller's
// quote about using Vendylio itself. Admin-authored content, not tied to any
// Order/Product row.
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String?
  detail    String?
  quote     String
  avatarUrl String?
  rating    Int?
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  store     Store?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — guest checkout + Stripe (platform account today, Connect in
// Phase 3). One Order per checkout attempt, scoped to the Store that owns
// the products in `lineItems`. `amount` is the grand total charged
// (subtotalCents + deliveryFeeCents + taxCents), smallest currency unit —
// for USD that's cents.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id      String  @id @default(cuid())
  // Phase 6 — human-friendly order reference shown to customers + merchants
  // (formatOrderNumber() renders it as "VND-10042"). A Postgres sequence
  // default: atomic, collision-free under concurrent checkout, and never
  // the "SELECT MAX(n)+1" anti-pattern. The raw `id` cuid stays the PK and
  // the internal/URL identifier; this is display-only.
  orderNumber Int   @unique @default(autoincrement())
  // Phase 7 — bearer credential for the guest tracking page + email links.
  // App-generated random 24 bytes (base64url, 32 chars) in POST /api/orders —
  // NOT the cuid `id`, NOT the sequential `orderNumber`: high-entropy,
  // non-enumerable, and rotatable (regenerate the column) if a link leaks.
  // Every guest-facing order read/write is keyed on this, never on `id`.
  trackingToken String @unique
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userId  String? // guest checkout is the norm — set only if the buyer happened to be logged in
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  amount   Int // grand total, smallest unit — subtotalCents + deliveryFeeCents + taxCents
  currency String @default("USD")
  // EXPIRED: set by the order-expiration cron (lib/server/orders/expire.ts) when a
  // PENDING order's expiresAt passes unpaid. FAILED: the Stripe Checkout Session
  // itself could not be created (network/API error) — distinct from EXPIRED so an
  // idempotency-key replay reports the right terminal state (CR-02).
  status   String @default("PENDING") // PENDING|PAID|PREPARING|READY|OUT_FOR_DELIVERY|DELIVERED|CANCELLED|REFUNDED|EXPIRED|FAILED

  subtotalCents     Int
  deliveryFeeCents  Int     @default(0)
  taxCents          Int     @default(0) // column ready; MVP always computes 0 (no tax engine)
  // Buyer's checkout choice — PICKUP: deliveryFeeCents forced to 0 and no
  // courier is ever involved (seller hands the order over in person, marked
  // done via the generic READY→DELIVERED transition). DELIVERY: existing
  // behavior — store's flat fee applies, self_manual/uber_direct handle it.
  fulfillmentMethod String  @default("DELIVERY") // PICKUP|DELIVERY
  customerEmail     String?
  customerPhone     String?
  customerName      String?
  deliveryAddress   Json?
  lineItems         Json // snapshot at checkout time: [{ productId, name, priceCents, quantity }]

  // Stripe-grade idempotency (CR-02). Required header on POST /api/orders;
  // replay with the same value returns the original outcome instead of
  // double-charging. `idempotencyBodyHash` binds the key to the checkout
  // body (storeId + lineItems) so a reused key with a different cart 422s
  // instead of silently returning the old order.
  idempotencyKey      String? @unique
  idempotencyBodyHash String?

  // Provider reference — "stripe_platform" | "stripe_connect" (Phase 3) |
  // "cashapp_manual" | "zelle_manual" (manual payment methods — no webhook
  // exists for either, the SELLER confirms receipt via
  // POST /api/orders/[id]/confirm-payment; providerChargeId/paymentUrl stay
  // null for these two, see api/orders/route.ts's routing).
  provider         String
  providerChargeId String? @unique
  paymentUrl       String? // Stripe Checkout Session URL — null for manual payment methods
  paymentMethod    String? // set on PAID (e.g. Stripe's payment_method_types entry, or "cashapp"/"zelle")

  // Marketplace commission (Phase 3 uses this to split platform vs. seller take)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  statusEvents OrderStatusEvent[]
  delivery     Delivery?
  review       Review?

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// Phase 4 — lightweight audit trail for the order lifecycle. One row per
// status change: the PAID transition is written by the Stripe webhook
// (actorType "SYSTEM"), everything after (PREPARING→READY→OUT_FOR_DELIVERY→
// DELIVERED, or CANCELLED) is written by the seller's PATCH
// /api/orders/[id] (actorType "SELLER"). Read-only from the API's
// perspective — nothing ever updates or deletes a row here.
model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorType String // SYSTEM | SELLER
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Phase 5 — delivery tracking, one row per Order once the seller requests
// delivery (POST /api/orders/[id]/delivery). Kept separate from
// OrderStatusEvent: this is provider-facing tracking data (trackingUrl,
// providerDeliveryId for a future real courier's correlation), not a
// generic audit log entry.
model Delivery {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String // self_manual | uber_direct (future)
  providerDeliveryId String? // opaque id from the delivery provider, if any
  status             String    @default("REQUESTED") // REQUESTED | DELIVERED | FAILED
  trackingUrl        String?
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Phase 8 — post-delivery review, one per Order (guest-submitted, no
// account needed — same trust model as the checkout success/tracking pages:
// knowing the unguessable Order id is the only "auth"). Gated at write-time
// to status === 'DELIVERED' (api/orders/[id]/review/route.ts). `storeId` is
// denormalized from Order.storeId so the seller's moderation list
// (GET /api/reviews) and the public storefront read don't need a join
// through Order. `visible` is the seller's moderation switch — hidden
// reviews still count toward nothing publicly but stay on record.
model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  text      String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, visible, createdAt])
}

// Phase 6 — lightweight guest-customer directory, upserted from the Stripe
// webhook's onPaid handler (api/webhooks/stripe/route.ts) keyed on
// (storeId, phone) — phone is always present on a checkout (Body requires
// it), email is optional so it's a secondary unique key only enforced when
// present. Not incremented at PENDING creation — a customer only "counts"
// once they've actually paid, same reasoning as stock decrement and the
// stores/me dashboard stats.
model Customer {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email           String?
  phone           String?
  name            String?
  address         Json?
  totalSpentCents Int      @default(0)
  ordersCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, email])
  @@unique([storeId, phone])
  @@index([storeId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Marketplace domain — one Store per Organization (Phase 1 — multi-tenancy),
// N Products per Store, N Orders per Store (Phase 2). Resolve a caller's own
// store via `resolveOwnStore()` (lib/server/org.ts), which goes through
// their OrganizationMember row — never query Store by userId directly, it
// no longer has that column.
// ───────────────────────────────────────────────────────────────────────
model Store {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug                     String       @unique
  name                     String
  description              String?
  city                     String?
  state                    String?
  logoUrl                  String?
  // Storefront contact number — shown prominently in the public storefront's
  // top bar (see StorefrontTopBar). Free-text, no format validation: sellers
  // span many countries/formats and this is display-only, never dialed
  // programmatically.
  phone                    String?
  // Storefront layout — MODERN (grid), MINIMAL (single-column list), or
  // BOLD (large imagery, editorial). See src/components/storefront/templates/.
  template                 String       @default("MODERN")
  // Gates visibility on /s/[slug]. Defaults true so onboarding (which has no
  // separate "Publish" step yet) keeps working end-to-end; a future
  // publish/unpublish toggle just flips this.
  published                Boolean      @default(true)
  // Phase 3 — Stripe Connect (direct-to-seller payouts, optional). A Store
  // without a connected account still sells fine via the Phase 2 platform
  // charge path — see api/orders/route.ts's routing check on
  // stripeOnboardingStatus === 'ACTIVE'.
  stripeAccountId          String?      @unique
  stripeOnboardingStatus   String       @default("NOT_STARTED") // NOT_STARTED|PENDING|ACTIVE|RESTRICTED
  // Manual payment methods — no webhook/API exists for either of these to
  // confirm a peer-to-peer payment automatically, so a buyer who checks out
  // this way sees the seller's Cash App QR / Zelle contact, the order stays
  // PENDING, and the SELLER manually confirms receipt via
  // POST /api/orders/[id]/confirm-payment (see lib/server/orders/markPaid.ts
  // for the same side effects a real Stripe payment triggers). Both null =
  // the checkout payment-method selector doesn't offer that option at all.
  cashAppCashtag           String? // stored WITHOUT the leading "$" (e.g. "AdaezeShop")
  zelleContact             String? // email or phone registered with Zelle — free text
  // Phase 5 — delivery. self_manual works with zero configuration (the
  // seller is their own courier) so it's the default for every store, no
  // separate on/off flag needed. uber_direct is a real courier integration
  // (lib/server/delivery/uber-direct.ts) that requires a pickup address —
  // self_manual ignores this column entirely (the seller picks up nothing,
  // they just walk the order out themselves).
  deliveryProvider         String       @default("self_manual")
  deliveryFeeCents         Int          @default(0)
  pickupAddress            String?
  // Phase 12 — Free/Pro tiers. No hard enforcement in the MVP (no feature is
  // gated behind PRO yet); the one branchable benefit today is a reduced
  // marketplace commission — see COMMISSION_RATE_BP_PRO and
  // resolveCommissionRateBp() in lib/server/payments/commission.ts.
  plan                     String       @default("FREE") // FREE|PRO
  // Phase 3 — inventory. Default "low stock" threshold applied to a product
  // whose own `lowStockThreshold` is null. A product/variant is LOW when its
  // quantity is > 0 and <= the effective threshold, OUT when quantity <= 0.
  defaultLowStockThreshold Int          @default(3)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  products       Product[]
  orders         Order[]
  customers      Customer[]
  reviews        Review[]
  categories     Category[]
  stockMovements StockMovement[]
}

// Per-store product categories. Replaced the old hard-coded 4-value
// `Product.category` enum so a seller can add/rename/reorder/delete their
// own. One category per product (Product.categoryId, nullable = "Sans
// catégorie"); deleting a category re-parents its products to null rather
// than blocking. Slug is unique per store and used as the storefront
// section anchor (/s/[slug]#<category-slug>).
model Category {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, sortOrder])
}

model Product {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  priceCents        Int
  // Float, not Int: a UNIT product's quantity is always a whole count
  // (enforced at the zod layer, not here — Prisma has no per-row numeric
  // constraint), but a weight unit (KG/LB/G/OZ) needs fractional amounts
  // like 12.09 lb. Always rounded to 2 decimal places wherever it's
  // written (lib/server/quantity.ts) so float drift never accumulates.
  quantity          Float     @default(0)
  // Nullable on purpose — a product with no category shows under "Sans
  // catégorie". Set null (not blocked) when its Category row is deleted.
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Phase 7 — unit the price/quantity above are denominated in. UNIT means
  // "priceCents per item" (the only mode before Phase 7); the weight units
  // let a seller price something like spices "per kg", with fractional
  // quantities (`quantity` counts however much of that unit is in stock —
  // e.g. quantity=12.09 with unit=LB means 12.09 lb on hand).
  unit              String    @default("UNIT") // UNIT | LB | KG | G | OZ
  imageUrl          String?
  status            String    @default("ACTIVE") // ACTIVE | ARCHIVED
  // Phase 3 — inventory. null = use the store's defaultLowStockThreshold.
  lowStockThreshold Int?
  // Phase 4 — low-stock alert re-arm gate. Set to now() when a low/out
  // notification is sent; reset to null by applyStockChange() the moment
  // stock climbs back above the effective threshold. A notification is only
  // (re-)emitted while this is null, so recovering + dropping again alerts
  // once per episode instead of on every decrement.
  lowStockNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variants       ProductVariant[]
  stockMovements StockMovement[]

  @@index([storeId, createdAt])
  @@index([storeId, categoryId])
}

// Phase 7 — simple independent variant options (e.g. "Size: Large",
// "250g bag"), NOT a Size×Color combinatorial matrix — a buyer picks at most
// ONE variant row per cart line, same simplification the plan calls for.
// When a product has variants, `quantity` below (not Product.quantity) is
// authoritative for that line's stock — see api/orders/route.ts and the
// Stripe webhook's stock-decrement step.
model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String // option group label, e.g. "Size" or "Weight"
  value           String // the specific option, e.g. "Large" or "1kg bag"
  priceDeltaCents Int      @default(0) // added to Product.priceCents when selected
  quantity        Float    @default(0) // same Float-for-fractional-weight reasoning as Product.quantity
  // Phase 4 — per-variant low-stock alert re-arm gate (see Product.lowStockNotifiedAt).
  lowStockNotifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([productId])
}

// Phase 3 — append-only inventory ledger. One row per stock change: a paid
// sale (SALE), a seller restock/adjustment (RESTOCK | MANUAL_ADJUST |
// CORRECTION), or a refund putting stock back (REFUND_RESTOCK). Written
// only via lib/server/inventory/adjust.ts's applyStockChange() so the
// product/variant `quantity` and this ledger never diverge.
model StockMovement {
  id                String          @id @default(cuid())
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta             Float // signed: -3 for a sale of 3, +10 for a restock
  resultingQuantity Float // quantity immediately after this movement (audit)
  reason            String // SALE | RESTOCK | MANUAL_ADJUST | CORRECTION | REFUND_RESTOCK
  note              String?
  orderId           String? // set for SALE / REFUND_RESTOCK
  actorType         String // SYSTEM | SELLER
  createdAt         DateTime        @default(now())

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit (cents for Vendylio's USD)
  currency    String @default("USD")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  // Vendylio sellers are US-based: { method: "CASH_APP", cashtag: "$..." } or
  // { method: "ZELLE", contact: "email or phone" } — see api/withdrawals/route.ts.
  destination Json

  // Provider reference
  provider         String // "manual" for Vendylio (Cash App/Zelle have no payout API — an operator fulfills by hand)
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Platform-wide settings — singleton row (id always "default"). Started
// with just the marketplace commission rate, previously only configurable
// via the COMMISSION_RATE_BP / COMMISSION_RATE_BP_PRO env vars (which
// required a redeploy to change) — now editable live from /admin/settings
// (SUPERADMIN-only, same as the Site Content CMS). See
// lib/server/payments/platform-settings.ts for the read helper and
// api/admin/settings/route.ts for the read/write endpoint.
model PlatformSettings {
  id                  String   @id @default("default")
  // Basis points: 600 = 6%. 0 = no commission taken.
  commissionRateBp    Int      @default(0)
  // Discounted rate for Store.plan === "PRO". Null = no PRO discount
  // configured — PRO stores fall back to commissionRateBp like everyone else.
  commissionRateBpPro Int?
  updatedAt           DateTime @updatedAt
}
