# =============================================================================
# izi kit — environment reference
# =============================================================================
# Copy this file to `.env.local` (or `.env`) at the repo root, then fill in
# the values you need. Keys are grouped by:
#
#   1. REQUIRED at boot (the app refuses to start without these)
#   2. RECOMMENDED at boot (warn-only; the app boots, but breaks at first use)
#   3. OPTIONAL providers (Cloudinary / Resend / Bictorys / Google OAuth / Sentry / Upstash)
#       — entirely env-gated, the app boots and `/api/auth` works without them
#   4. TUNABLES (auth lockout, rate limits, withdrawal policy, upload policy …)
#
# Source of truth for the validation schema:
#   frontend/src/lib/server/env.ts (boot-time zod schema, throws on misconfig)
# =============================================================================


# =============================================================================
# 1. REQUIRED at boot
# =============================================================================

# Postgres connection — Neon's "-pooler" host routes through PgBouncer in
# transaction mode. `connection_limit=1` is REQUIRED on serverless: each
# Vercel function instance opens its own pool, and per-instance multi-conn
# pools exhaust Neon's ceiling under moderate concurrency.
#
# This kit is cloud-only: there is NO local Postgres. Create a free Neon
# project at https://neon.tech, copy the `-pooler` connection string here
# and the non-pooled string into DIRECT_URL below.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?pgbouncer=true&connection_limit=1&pool_timeout=15&sslmode=require"

# JWT signing secret — minimum 32 chars (validator rejects shorter values
# at boot). Generate with: `openssl rand -base64 48`
# Strings starting with "change-me", "secret", "test"… are rejected.
JWT_SECRET=""


# =============================================================================
# 2. RECOMMENDED at boot
# =============================================================================

# Direct (non-pooled) Postgres URL — REQUIRED for `prisma migrate deploy`.
# The pooler exhausts on long-lived migrations and breaks prepared statements.
# Without DIRECT_URL set, migrations time out or fail mid-run.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Vercel Cron auth shared secret. Required by /api/cron/* routes.
# Generate with: `openssl rand -base64 32`
# Single shared secret across all cron handlers.
CRON_SECRET=""

# AES-256-GCM encryption key for sensitive blob fields (OAuth refresh tokens,
# integration secrets). Required once you store encrypted data — Phase 1 auth
# works without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""


# =============================================================================
# 3. APP origin / cookies
# =============================================================================

# Public origin URL — used for email link generation, OAuth callback base,
# and CORS construction. Set this per environment.
APP_URL="http://localhost:3000"

# Comma-separated additional CORS origins (when serving from multiple domains).
# Leave empty to accept only same-origin (default in a monolith).
ALLOWED_ORIGINS=""

# Cookie name prefix. All auth cookies are namespaced "${COOKIE_PREFIX}-token",
# "${COOKIE_PREFIX}-refresh", "${COOKIE_PREFIX}-csrf". Change per app so a dev
# sharing localhost across two starters doesn't clobber sessions.
COOKIE_PREFIX="app"

# Cookie domain for production (e.g. ".example.com" so cookies are shared
# across www.example.com and api.example.com). Leave empty for localhost dev.
# COOKIE_DOMAIN=""

# Mirrors COOKIE_PREFIX for the browser bundle (must be NEXT_PUBLIC_*).
NEXT_PUBLIC_COOKIE_PREFIX="app"

# Comma-separated path prefixes the silent-refresh middleware guards
# (frontend/middleware.ts). Empty by default (no-op) — set per fork once you
# have authed pages. Vendylio's seller flow needs its onboarding + dashboard.
AUTH_PROTECTED_PREFIXES="/dashboard,/onboarding"

# Where the middleware redirects unauthenticated visitors to a protected path.
# AUTH_LOGIN_PATH="/login"

# Node environment. The logger redacts PII when this is "production" or any
# unknown value (fail-safe). Leave unset / "development" locally.
# NODE_ENV=development


# =============================================================================
# 4. OPTIONAL — Upstash Redis (rate limit, leader-lease, lockout, refresh-lock)
# =============================================================================
# Without these, the rate limiter falls back to an in-memory store
# (logged as `log.warn` at boot). DO NOT run in production without Upstash —
# in-memory state is per-instance and resets on every cold start.

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# =============================================================================
# 5. OPTIONAL — Email (Resend)
# =============================================================================
# Without these, the email queue (EmailJob rows) accumulates but is never
# drained — the cron `/api/cron/email-queue-drain` logs a warn and skips.
# Once the API key arrives, queued rows flush on the next cron tick.

RESEND_API_KEY=""

# Verified sender — must match a domain or address verified in your Resend
# project. Format accepts `"Name <addr@domain.com>"` or plain `addr@domain.com`.
EMAIL_FROM=""


# =============================================================================
# 6. OPTIONAL — Cloudinary (media storage)
# =============================================================================
# Required for `POST /api/upload` — without these the route returns
# 503 STORAGE_NOT_CONFIGURED. Leave empty if your project doesn't need
# uploads; the rest of the kit boots fine.
#
# Sign up free at https://cloudinary.com — copy the three values straight
# from the dashboard ("Cloud name", "API Key", "API Secret"). No bucket
# policies, no S3 keys, no endpoint URL — that's the whole setup.
#
# ⚠️ SECURITY — Cloudinary `secure_url` is publicly accessible. Anyone with
# the URL can fetch the file (no auth, no expiry). This is fine for avatars,
# product images, public posts. For private files (KYC docs, invoices, IDs)
# you MUST add Cloudinary signed delivery URLs or implement your own
# owner-gated proxy route — the v1 kit ships neither.

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: named upload preset (server-side config in the Cloudinary
# dashboard — Settings → Upload). Use it to apply default folders, eager
# transformations, or tag conventions without changing route code. Leave
# empty for the default signed-upload behaviour.
CLOUDINARY_UPLOAD_PRESET=""


# =============================================================================
# 7. OPTIONAL — Google OAuth
# =============================================================================
# Get these at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). The authorized redirect URI
# in Google Console must match GOOGLE_REDIRECT_URI exactly.
# Without these, /api/auth/oauth/google/* routes return 404.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"


# =============================================================================
# 8. OPTIONAL — Payments (Stripe)
# =============================================================================
# Phase 2 wired platform Checkout (guest checkout, POST /api/orders + the
# Stripe webhook); Phase 3 adds Connect (direct-to-seller payouts). Without
# these set, POST /api/orders returns 503 PAYMENT_PROVIDER_UNCONFIGURED —
# the storefront/cart still render, checkout just can't complete.

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Phase 3 — Stripe Connect. Configure a SEPARATE webhook endpoint in the
# Stripe dashboard's Connect settings listening for `account.updated` +
# `transfer.reversed` (POST /api/webhooks/stripe-connect) — Stripe issues it
# its own signing secret, distinct from STRIPE_WEBHOOK_SECRET above. Without
# this set, POST /api/stores/stripe/onboard still works (it only needs
# STRIPE_SECRET_KEY), but a connected account's status will only ever update
# via GET /api/stores/stripe/status's opportunistic refresh, not in real time.
# `transfer.reversed` (Phase 2) flips a bounced BANK/ACH payout to FAILED so
# the seller's balance is released — without it a reversed transfer leaves the
# withdrawal stuck COMPLETED.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# DEPRECATED — no longer read. The marketplace commission rate (basis
# points, 600 = 6%) is now stored in the PlatformSettings DB row and
# configured live at /admin/settings (SUPERADMIN-only) — see
# lib/server/payments/platform-settings.ts. Changing it here does nothing;
# left in place only as a historical note. Defaults to 0% (no commission)
# until a SUPERADMIN sets a rate in the UI.
COMMISSION_RATE_BP=""
COMMISSION_RATE_BP_PRO=""

# Vendylio Pro subscription (Stripe Billing). This is Vendylio billing the
# MERCHANT $29/mo — distinct from the payment/Connect keys above (those are
# the merchant's customers paying the merchant). Create a recurring Price in
# your Stripe dashboard and put its id here. Configure a SEPARATE webhook
# endpoint (POST /api/webhooks/stripe-billing) subscribed to
# customer.subscription.created/updated/deleted + invoice.paid +
# invoice.payment_failed + checkout.session.completed — Stripe issues it its
# own signing secret. Without STRIPE_PRO_PRICE_ID + STRIPE_SECRET_KEY, POST
# /api/billing/checkout returns 503 BILLING_NOT_CONFIGURED and the dashboard
# just hides the "Upgrade to Pro" button; everything else works and every
# store stays on the Free plan.
STRIPE_PRO_PRICE_ID=""
STRIPE_BILLING_WEBHOOK_SECRET=""
# Display only — the price shown on the public /pricing page. Does not affect
# what Stripe actually charges (that's STRIPE_PRO_PRICE_ID).
BILLING_PRO_PRICE_USD="29"
# Phase 5 — optional annual Pro price. Create a second recurring price (yearly)
# on the SAME product in Stripe and put its id here. Without it the billing
# page's monthly/annual toggle falls back to the monthly price for both.
STRIPE_PRO_ANNUAL_PRICE_ID=""

# Phase 1b — Cash App / Zelle marketplace commission. When a merchant confirms
# a Cash App / Zelle order, the platform's cut is recorded as a receivable
# (CommissionCharge, status OWED) and withheld from their next withdrawal. A
# merchant with no withdrawable balance is instead billed on their card on
# file: the daily commission-settlement-sweep cron creates a Stripe invoice
# once their OWED total clears this threshold (cents, default 1000 = $10).
COMMISSION_MIN_INVOICE_CENTS="1000"

# Phase 4b — custom storefront domains (Pro). A merchant connects
# "shop.brand.com" in Settings → Domain; we attach it to THIS Vercel project
# via the Vercel Domains API and the edge middleware rewrites requests on that
# Host to the storefront. Create a token at vercel.com/account/tokens with
# access to the project; VERCEL_PROJECT_ID is the project's id/name;
# VERCEL_TEAM_ID only for team-scoped projects. Without VERCEL_API_TOKEN +
# VERCEL_PROJECT_ID, /api/stores/domain returns 503 DOMAIN_NOT_CONFIGURED and
# the Domain tab shows "not available yet".
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""


# =============================================================================
# 9. OPTIONAL — Delivery & Fulfillment Engine (Uber Direct + DoorDash Drive)
# =============================================================================
# The fulfillment engine (src/lib/server/fulfillment/) routes every order
# through Uber Direct, DoorDash Drive, Merchant delivery, or Pickup. Merchant
# + Pickup need NO credentials. The two couriers below are PLATFORM-level —
# ONE Uber Direct account and ONE DoorDash Drive account for the whole
# platform; the merchant UI only toggles methods on/off, it never stores a
# secret. A courier with no credentials set is simply hidden at checkout.
#
# --- Uber Direct ---
# Get these at https://developer.uber.com/dashboard under your Direct app's
# Authentication + Docs pages.
#
# ⚠️ These credentials are PLATFORM-level (one set for the whole app, not
# per-seller) — Uber Direct dispatches from whatever pickup address the
# request specifies (Store.pickupAddress), so no per-seller Uber account is
# needed.

UBER_DIRECT_CLIENT_ID=""
UBER_DIRECT_CLIENT_SECRET=""
# The "Customer ID" (a.k.a. organization ID) shown on your Direct dashboard —
# distinct from CLIENT_ID, scopes all delivery/quote API calls.
UBER_DIRECT_CUSTOMER_ID=""

# Configure a webhook endpoint in the Direct dashboard pointing at
# https://<your-domain>/api/webhooks/uber-direct listening for delivery
# status events. Uber issues a separate per-webhook signing key (shown when
# you create the endpoint) — distinct from CLIENT_SECRET above, which
# authenticates OUTBOUND API calls, not this inbound webhook.
UBER_DIRECT_WEBHOOK_SIGNING_KEY=""

# 1 = attach Uber's robo-courier test specification to every delivery
# request, which completes automatically in Uber's sandbox without
# dispatching a real courier. Use this while testing against a Direct
# sandbox account; leave unset in production.
UBER_DIRECT_SANDBOX_TEST_MODE=""

# --- DoorDash Drive (Prompt #12) ---
# Get these at https://developer.doordash.com → Credentials. DoorDash Drive
# authenticates with a short-lived JWT the client self-signs from these three
# values (developer id, key id, and a base64url signing secret). Wired in
# Phase 3; unset = DoorDash hidden at checkout, no error.
DOORDASH_DEVELOPER_ID=""
DOORDASH_KEY_ID=""
DOORDASH_SIGNING_SECRET=""
# Inbound webhook auth. Prefer the HMAC secret (same scheme as Uber's
# signing key); the Basic-Auth pair is a fallback for DoorDash accounts that
# only offer that. Set whichever your Drive webhook config uses.
DOORDASH_WEBHOOK_SECRET=""
DOORDASH_WEBHOOK_USERNAME=""
DOORDASH_WEBHOOK_PASSWORD=""
# 1 = use the DoorDash sandbox base URL + credentials (auto dasher
# simulation, no real driver). Leave unset in production.
DOORDASH_SANDBOX=""

# --- Fulfillment engine tunables ---
# Max create-delivery attempts before the fulfillment-tick cron gives up and
# marks the Delivery FAILED (recoverable — the seller retries from the order).
FULFILLMENT_DISPATCH_MAX_ATTEMPTS="6"
# Per-provider quote timeout at checkout (ms) — one slow courier can't stall
# the whole checkout; it just drops out of the options.
FULFILLMENT_QUOTE_TIMEOUT_MS="4000"
# How long a flat-fee (Merchant) quote stays valid, in seconds — courier
# quotes carry the provider's own expiry instead.
FULFILLMENT_QUOTE_FALLBACK_TTL_SECONDS="300"
# Prompt #13 — hard deadline (ms) on every non-quote provider call (create /
# get / cancel delivery). A timeout is handled like any provider error.
FULFILLMENT_PROVIDER_TIMEOUT_MS="10000"
# Prompt #13 — stale-delivery WARN thresholds for the fulfillment-tick sweep.
# Detection only: it logs + counts, it never cancels a delivery.
FULFILLMENT_STALE_DISPATCH_MINUTES="30"
FULFILLMENT_STALE_UNASSIGNED_MINUTES="20"
FULFILLMENT_STALE_IN_TRANSIT_HOURS="4"

# Prompt #13.5 — real courier sandbox validation harness
# (`pnpm --filter frontend provider:sandbox-check`). Both OFF by default; the
# harness makes REAL calls to the courier sandbox APIs when the first is "1".
# It still aborts on NODE_ENV=production and without each courier's *_SANDBOX
# flag. See docs/fulfillment/sandbox-runbook.md.
RUN_PROVIDER_SANDBOX_TESTS=""
# "1" also creates → polls → cancels one sandbox delivery per configured courier.
RUN_PROVIDER_SANDBOX_CREATE=""


# =============================================================================
# 10. OPTIONAL — AI (Anthropic — "Generate Description")
# =============================================================================
# Powers POST /api/ai/generate-description (the "Generate with AI" button in
# the product form and store setup form). Uses claude-haiku-4-5 — cheap and
# fast enough for a single short-copy call. Without this set, the route
# returns 503 AI_NOT_CONFIGURED and the buttons show a friendly inline error;
# nothing else in the app depends on it.
ANTHROPIC_API_KEY=""


# =============================================================================
# 11. OPTIONAL — Sentry (error reporting + tracing)
# =============================================================================
# Without SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN, the Sentry SDKs become silent
# no-ops (no events sent, no perf overhead).

# Server-side DSN:
SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"            # defaults to NODE_ENV
# SENTRY_RELEASE="myapp@1.2.3"               # set by CI for source-map matching
# SENTRY_TRACES_SAMPLE_RATE="0.1"            # 0.0–1.0 — default 0 (off)

# Frontend (browser) DSN — separate Sentry project recommended so client
# events don't pollute server-side dashboards.
NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_RELEASE="myapp@1.2.3"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_REPLAYS_SAMPLE_RATE="0"  # session replay opt-in (costly)

# Source-map upload (CI only). Without these the build still succeeds but
# stack traces won't be symbolicated in Sentry.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""


# =============================================================================
# 11b. OPTIONAL — Bot protection (hCaptcha) on login / signup / forgot-password
# =============================================================================
# INERT when HCAPTCHA_SECRET is unset — every auth form works exactly as
# before (this is the local-dev / headless-starter default). When set, the
# login, signup and forgot-password routes reject a request whose hCaptcha
# token fails server-side siteverify with 400 CAPTCHA_FAILED, before any
# rate-limit / bcrypt / user-lookup work runs. The verify token is a one-time
# value and is NEVER logged. Keys are PLATFORM-level (one hCaptcha site for
# the whole app), not per-store.

# Server secret — https://dashboard.hcaptcha.com -> your site -> Settings.
HCAPTCHA_SECRET=""
# Public site key — safe to expose to the browser (the widget needs it).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
# 1 = on a network error / timeout talking to hCaptcha, ALLOW the request
# (fail open) instead of rejecting it. Set this if an hCaptcha outage locking
# every user out is worse for you than a brief no-bot-protection window. A
# hard `success:false` from hCaptcha is always a rejection regardless.
HCAPTCHA_FAIL_OPEN=""


# =============================================================================
# 12. TUNABLES — Auth (Phase 1)
# =============================================================================
# All optional. Defaults below are production-safe (per CONTEXT.md decisions
# D-06, D-07, D-08, D-10, D-13). Override only with cause.

# Minimum password length (NIST 800-63B aligned).
AUTH_PASSWORD_MIN_LENGTH=10

# Verification code TTL in minutes. Codes are 8-char Crockford alphanumeric,
# single-use (consumed via VerificationCode.usedAt).
AUTH_VERIFICATION_TTL_MIN=15

# Failed-login lockout (AUTH-10). After AUTH_LOCKOUT_THRESHOLD failures within
# AUTH_LOCKOUT_DURATION_MIN minutes, the account is locked out for the same
# duration. Backed by Redis sliding-window counter (memory fallback in dev).
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MIN=15

# Per-email rate limits (AUTH-10). Keyed on lower-cased email, falls back to
# per-IP when the email is missing (parse failure / malformed body).
AUTH_LOGIN_RATE_LIMIT_MAX=10              # 10 / 15 min per email
AUTH_SIGNUP_RATE_LIMIT_MAX=5              # 5 / 1 hour per email
AUTH_FORGOT_RATE_LIMIT_MAX=3              # 3 / 1 hour per email
AUTH_RESET_RATE_LIMIT_MAX=5               # 5 / 15 min per email
AUTH_RESEND_VERIFY_RATE_LIMIT_MAX=3       # 3 / 1 hour per email (reserved for future endpoint)
AUTH_VERIFY_RATE_LIMIT_MAX=5              # 5 / 15 min per email

# API-01 — per-IP limits on the PUBLIC guest checkout surface (no email/user to
# key on). 1-minute windows; the defaults sit well above any real shopper.
CHECKOUT_IP_RATE_LIMIT_MAX=12             # POST /api/orders — 12 / min per IP
QUOTE_IP_RATE_LIMIT_MAX=30                # POST /api/cart/validate + delivery-quote — 30 / min per IP
TRACKING_IP_RATE_LIMIT_MAX=60            # GET /api/orders/track/[token] — 60 / min per IP
VIEW_IP_RATE_LIMIT_MAX=60                # POST /api/track (storefront analytics beacon) — 60 / min per IP
LEAD_IP_RATE_LIMIT_MAX=5                 # POST /api/business-waitlist (/pricing Business form) — 5 / min per IP
CSP_REPORT_RATE_LIMIT_MAX=30             # POST /api/csp-report — 30 / min per IP (UX-01, see docs/security/csp.md)

# HIBP haveibeenpwned password check. Opt-in (default OFF).
# When enabled, signup / reset-password / change-password reject passwords
# found in known breaches via k-anonymity (first 5 chars of SHA-1 sent to
# api.pwnedpasswords.com — full password and full hash never leave the server).
# Fail-open on network error (logs warn).
PASSWORD_HIBP_CHECK=

# Email rate-limiter behaviour when Upstash is unreachable.
# Default OFF (fail-open) — the limiter logs warn and lets the request through
# so a Redis blip doesn't take auth offline. In prod with real abuse pressure
# you probably want fail-closed (return 429). Set to "1" to enable.
AUTH_RATE_LIMIT_FAIL_CLOSED=

# /api/auth/forgot-password wall-clock floor (ms). Pads each response so the
# user-exists vs. no-user paths are timing-indistinguishable, defending
# against email-enumeration timing attacks. 350ms = production-safe default.
# Set to "0" in tests to avoid 350ms per case.
AUTH_FORGOT_TARGET_LATENCY_MS=350


# =============================================================================
# 13. TUNABLES — Upload policy (Phase 4, applied by POST /api/upload)
# =============================================================================

# Comma-separated MIME whitelist. Magic bytes verified by sniff.ts; extending
# this list to a MIME without a sniffer logs a boot warning and trusts the
# client (XSS risk on text-ish formats — your call).
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp"

# Max single-file size in bytes (10 MB default). Vercel Route Handlers can
# stream past the platform 4.5 MB body limit via req.formData(), but bigger
# files = bigger Vercel + Cloudinary bills.
UPLOAD_MAX_BYTES="10485760"


# =============================================================================
# 14. TUNABLES — Withdrawal policy (Phase 4, production-safe defaults)
# =============================================================================
# ⚠️  These are FINANCIAL policy. Read each comment before editing in prod.

# Min withdrawal amount in smallest currency unit. Vendylio uses USD cents —
# 1000 = $10.00. (Starter default assumed XOF; adjust per your currency.)
WITHDRAWAL_MIN_AMOUNT="1000"

# Cap per single withdrawal request (smallest unit). Empty = unlimited.
WITHDRAWAL_MAX_AMOUNT=""

# Cap on sum of withdrawals per 24h (smallest unit). Empty = unlimited.
WITHDRAWAL_DAILY_LIMIT=""

# Min hours between withdrawal requests per user. 0 = no cooldown.
WITHDRAWAL_COOLDOWN_HOURS="0"

# 1 = require PIN in body on POST /api/withdrawals. 0 = no PIN required
# (NOT recommended for real-money projects).
WITHDRAWAL_REQUIRE_PIN="1"

# WITHDRAWAL_BALANCE_CHECK
# Default: 1 (balance check enabled — withdrawals must not exceed balance)
# ⚠️  FINANCIAL-SAFETY WARNING — DO NOT CASUALLY DISABLE  ⚠️
# Set to 0 ONLY if you have an alternative ledger that gates withdrawals
# upstream of this route (e.g., your own balance-tracking microservice).
# Disabling on a real-money project = users can withdraw money they don't
# have. This is a compliance regression. Document the alternative ledger
# in your fork's CLAUDE.md or README before flipping this.
WITHDRAWAL_BALANCE_CHECK="1"


# =============================================================================
# 15. TUNABLES — Webhook log retention + order expiration (Phase 5)
# =============================================================================

# /api/cron/webhook-log-purge (daily) deletes WebhookLog rows older than this.
# Compliance teams sometimes want 1y or 7y retention; flip this knob without
# re-deploying. Default 90 days.
WEBHOOK_LOG_RETENTION_DAYS="90"

# Fork-customizable knob for the order-creation route to compute
# Order.expiresAt = createdAt + N minutes. The /api/cron/order-expiration
# (every 5 min) reads Order.expiresAt directly and is INDEPENDENT of this env
# — but forks adjusting checkout windows tweak this single value rather than
# the route code. Default 30 min.
ORDER_EXPIRATION_MINUTES="30"

# ORD-01 — /api/cron/order-nudge (hourly) reminds the store owner (once, in-app +
# email) when a PAID/PREPARING order has sat untouched this many hours. The
# seller already gets an email the moment the order is paid (NOTIF-01); this is
# the backstop for a missed one. Default 6h. `ORDER_NUDGE_MAX_AGE_HOURS`
# (default 96) caps how far back the sweep looks so a first deploy doesn't blast
# a backlog.
ORDER_NUDGE_HOURS="6"
ORDER_NUDGE_MAX_AGE_HOURS="96"


# =============================================================================
# 16. DEV-ONLY — Smoke tests and local bypasses
# =============================================================================
# These only matter when running scripts/* locally; they are NEVER read by the
# server in production. Setting them in a prod env has no effect.

# Override target host for `pnpm smoke:auth` (defaults to http://localhost:3000).
# Use against a Vercel preview deploy or a colleague's tunnel:
# SMOKE_BASE_URL="https://my-preview.vercel.app"

# 1 = bypass HMAC verification in /api/webhooks/* during local smoke tests.
# NEVER set this in production — it disables the anti-replay + integrity guard.
# Used by the optional webhook-side smoke harness (not enabled in v1).
SMOKE_BYPASS_WEBHOOK_VERIFY=""


# =============================================================================
# 17. OPTIONAL — Banani MCP (design import workflow, see WORKFLOW.md)
# =============================================================================
# Banani is an OPTIONAL design tool. Connect it via MCP if you have designs
# already drawn — the `banani-design-implementation` skill reads your selected
# screens directly and reproduces them pixel-perfect. If you don't have a
# Banani project, ignore this section entirely and describe your screens in
# natural language to Claude instead. The setup-kit skill walks through the
# MCP connection in Phase 5 (oui / non / plus tard branching).
#
# Note: Banani gives you a free MCP connection block (no paid API key) — you
# paste the block straight into .mcp.json. This BANANI_API_KEY env var is only
# needed if the connection block Banani gives you references a token env var;
# leave empty otherwise.
BANANI_API_KEY=""
